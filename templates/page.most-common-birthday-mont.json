      "settings": {
        "custom_liquid": "<div class=\"embed-code\" style=\"text-align: start;\">\n<center>\n<textarea style=\"width: 573px; height: 100px; border: 1px solid #004275 !important; color: #004275;\" readonly=\"\" data-mce-style=\"width: 573px; height: 100px;\">\n<a href=\"https://www.kremp.com/pages/most-common-birthday-month-and-year-by-state\">\n<img src=\"https://cdn.shopify.com/s/files/1/0912/4927/9256/files/most-common-birthday-month-year-state-6.png?v=1752224713\" alt=\"What is the Most Common Birthday Month and Year in the U.S.? - Kremp Florist Birthday Flowers - Infographic\" title=\"What is the Most Common Birthday Month and Year in the U.S.? - Kremp.com - Infographic\"></a><br><a href=\"https://www.Kremp.com\" alt=\"Kremp Florist Birthday Flowers\" title=\"Kremp.com\">By Kremp.com</a>\n</textarea>\n</center>\n</div>",
