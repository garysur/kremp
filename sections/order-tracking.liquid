<div style="max-width:500px; margin:60px auto; padding:20px; font-family:sans-serif;">
  <h2 style="margin-bottom:8px;">Track Your Order</h2>
  <p style="color:#666; margin-bottom:24px;">Enter your order number and email address to see your delivery status.</p>

  <div style="margin-bottom:16px;">
    <label style="display:block; font-size:13px; margin-bottom:6px;">Order Number</label>
    <input type="text" id="order-number" placeholder="e.g. 37101"
      style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; font-size:14px; box-sizing:border-box;">
  </div>

  <div style="margin-bottom:20px;">
    <label style="display:block; font-size:13px; margin-bottom:6px;">Email Address</label>
    <input type="email" id="order-email" placeholder="Enter your email"
      style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; font-size:14px; box-sizing:border-box;">
  </div>

  <button onclick="trackOrder()"
    style="width:100%; padding:12px; background:#1a1a1a; color:#fff; border:none; border-radius:6px; font-size:15px; cursor:pointer;">
    Track Order
  </button>

  <div id="result" style="margin-top:24px;"></div>
</div>

<script>
const LOCAL_ZONES = ["CC-CC","CC-NS","CC-WP","CC-SP","L-AJ","LB-BB","LB-FNE","LB-LL","LB-SH","LB-YN","L-EP","L-GW","L-HV","ML-D","ML-DC","ML-L","ML-NOR","NE-CR","NE-GT","NE-MD","NE-OL","U-AM","U-DOY","U-HH","U-HP","U-LNW","WG"];
const WIRE_ZONES = ["WIRE","WIRE OUT"];
const SHIPPED_ZONES = ["DS-FEDEX","DS-UPS","DS-USPS"];

function getZoneType(zone) {
  if (!zone) return null;
  const z = zone.toUpperCase().trim();
  if (LOCAL_ZONES.includes(z)) return 'LOCAL';
  if (WIRE_ZONES.includes(z)) return 'WIRE';
  if (z === 'FIG') return 'FIG';
  if (SHIPPED_ZONES.includes(z)) return 'SHIPPED';
  if (z === 'WEB PICKUP') return 'PICKUP';
  return null;
}

function formatDate(dateStr) {
  if (!dateStr) return '';
  const parts = dateStr.split('T')[0].split('-');
  const d = new Date(parts[0], parts[1] - 1, parts[2]);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function isPast(dateStr) {
  if (!dateStr) return false;
  const parts = dateStr.split('T')[0].split('-');
  const d = new Date(parts[0], parts[1] - 1, parts[2]);
  const today = new Date();
  today.setHours(0,0,0,0);
  return d < today;
}

function getMessage(status, zoneType, deliveryDate, isFlexHoliday) {
  const formattedDate = formatDate(deliveryDate);
  const past = isPast(deliveryDate);
  const s = status ? status.toLowerCase() : '';

  if (isFlexHoliday) {
    if (zoneType !== 'WIRE') return null;
    if (s === 'delivered') return 'This order has been delivered. Thank you for choosing Kremp.com!';
    if (s === 'pending') {
      if (past) return 'All orders placed during the flex holiday delivery period are being delivered as quickly as possible. Please refer to your order confirmation email for more information.';
      return 'We have your order in the queue to be delivered within the flex holiday delivery period. Please refer to your order confirmation email for more information.';
    }
    if (s === 'cancelled') return 'This order shows as being cancelled. If this does not seem accurate, please reach out to us. We are happy to look into this further.';
    return null;
  }

  if (s === 'delivered') {
    if (zoneType === 'LOCAL') return 'Your order has been delivered. The delivery took place on ' + formattedDate + '. Thank you for choosing Kremp.com!';
    if (zoneType === 'WIRE') return 'This order has been delivered. Thank you for choosing Kremp.com!';
    if (zoneType === 'FIG' || zoneType === 'SHIPPED') return 'This order was delivered. For additional information, please refer to the tracking details that were emailed to you at the time we shipped.';
    if (zoneType === 'PICKUP') return 'This order has been picked up. Thank you for choosing Kremp.com!';
  }

  if (s === 'pending') {
    if (!past) {
      if (zoneType === 'LOCAL') return 'This order is scheduled for delivery on ' + formattedDate + '. We will be sending a delivery confirmation email once this is delivered.';
      if (zoneType === 'WIRE') return 'We have your order scheduled for delivery ' + formattedDate + '. We do send delivery confirmation emails once the driver marks it delivered.';
      if (zoneType === 'FIG') return 'All fig orders are shipped out when ready. You will receive tracking details once we ship.';
      if (zoneType === 'SHIPPED') return 'We have your order scheduled to be shipped out on ' + formattedDate + '. You will receive tracking details once we ship.';
    } else {
      if (zoneType === 'LOCAL') return 'This order should have been delivered on ' + formattedDate + '. Most likely the driver tagged the door and we are waiting to hear from the recipient to schedule the redelivery. Feel free to reach out to us if you have additional contact information for the recipient.';
      if (zoneType === 'WIRE') return 'This order should have been delivered on ' + formattedDate + ' but we did not get confirmation from our delivery service just yet. Please reach out to us so we can look into this further and get your confirmation.';
      if (zoneType === 'FIG') return 'All fig orders are shipped out when ready. You will receive tracking details once we ship.';
      if (zoneType === 'SHIPPED') return 'Since this order is shipped, please refer to the tracking information provided by the shipping carrier (Fedex/UPS/USPS).';
    }
  }

  if (s === 'cancelled') return 'This order shows as being cancelled. If this does not seem accurate, please reach out to us. We are happy to look into this further.';

  return null;
}

async function trackOrder() {
  const orderNumber = document.getElementById('order-number').value.trim();
  const email = document.getElementById('order-email').value.trim().toLowerCase();
  const result = document.getElementById('result');

  if (!orderNumber || !email) {
    result.innerHTML = '<p style="color:red;">Please enter both your order number and email.</p>';
    return;
  }

  result.innerHTML = '<p style="color:#666;">Looking up your order...</p>';

  try {
    const response = await fetch('https://hook.us2.make.com/ev5spho1iqrqp6tblkw0asjkf6pcz81b', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order_number: orderNumber, email: email })
    });

    const data = await response.json();

    if (!data || data.error) {
      result.innerHTML = '<div style="background:#FCEBEB; padding:16px; border-radius:8px;"><p style="margin:0; color:#A32D2D;">We could not find an order matching that information. Please double-check your order number and email address.</p></div>';
      return;
    }

    if (!data.delivery_status) {
      result.innerHTML = '<div style="background:#f9f5ef; border:1px solid #e0d6c8; padding:20px; border-radius:8px;"><p style="margin:0;">We will have updated details once we receive the next update from our delivery system. Please check back later.</p></div>';
      return;
    }

    const zone = data.delivery_zone_name || '';
    const status = data.delivery_status || '';
    const deliveryDate = data.delivery_date || '';
    const shopifyDeliveryDate = data.shopify_delivery_date || '';
    const isFlexHoliday = shopifyDeliveryDate.toString().toLowerCase().indexOf('flex') !== -1;
    const zoneType = getZoneType(zone);
    const message = getMessage(status, zoneType, deliveryDate, isFlexHoliday);

    if (!message) {
      result.innerHTML = '<div style="background:#f9f5ef; border:1px solid #e0d6c8; padding:20px; border-radius:8px;"><p style="margin:0;">We will have updated details once we receive the next update from our delivery system. Please check back later.</p></div>';
      return;
    }

    result.innerHTML = '<div style="background:#f9f5ef; border:1px solid #e0d6c8; padding:20px; border-radius:8px;">'
      + '<p style="margin:0 0 12px 0;">' + message + '</p>'
      + '<p style="margin:0; font-size:0.9em; color:#555;">Have questions? <a href="https://www.kremp.com/pages/contact">Send us a message</a> — we\'re happy to help.</p>'
      + '</div>';

  } catch(e) {
    result.innerHTML = '<div style="background:#FCEBEB; padding:16px; border-radius:8px;"><p style="margin:0; color:#A32D2D;">Something went wrong. Please try again or contact us directly.</p></div>';
  }
}
</script>
