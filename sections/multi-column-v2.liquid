<div class="section" id="{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="container">
      <div
        class="section__header text-center"
        {% if settings.animations_enabled != 'disabled' %}data-cc-animate{% endif %}
      >
        <h2 class="h2 section__heading">{{ section.settings.title | escape }}</h2>
      </div>
    </div>
  {%- endif -%}

  <div class="container">
    <div class="mcv2__grid">
      {%- for block in section.blocks -%}
        <div
          class="mcv2__card"
          {{ block.shopify_attributes }}
          {% if settings.animations_enabled != 'disabled' %}
            data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.1 }}s"
          {% endif %}
        >
          <div class="mcv2__image-wrap">
            {%- if block.settings.image != blank -%}
              {%- capture sizes -%}
                {%- render 'sizes-attribute', grid: true, min: 1, md: 2 -%}
              {%- endcapture -%}
              {% render 'image',
                image: block.settings.image,
                widths: '300, 460, 600',
                src_width: 300,
                sizes: sizes,
                section_index: section.index
              %}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'media__placeholder' }}
            {%- endif -%}
          </div>

          <div class="mcv2__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="mcv2__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <a
                class="{{ section.settings.button_style }}"
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #{{ section.id }} .mcv2__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  #{{ section.id }} .mcv2__card {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1 1 calc(50% - 12px);
    min-width: min(100%, 320px);
    background: rgba(0, 0, 0, 0.04);
    overflow: hidden;
    gap: 24px;
    padding: 24px;
  }

  #{{ section.id }} .mcv2__image-wrap {
    flex: 0 0 calc(50% - 12px);
    width: calc(50% - 12px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section.id }} .mcv2__image-wrap img,
  #{{ section.id }} .mcv2__image-wrap svg {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #{{ section.id }} .mcv2__content {
    flex: 0 0 calc(50% - 12px);
    width: calc(50% - 12px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  #{{ section.id }} .mcv2__heading {
    font-size: var(--typography-text-size-H3, 40px);
    font-style: normal;
    font-weight: 500;
    line-height: 110%;
    letter-spacing: -0.8px;
    color: var(--color-heading, #004275);
    margin: 0;
  }

  @media (max-width: 768px) {
    #{{ section.id }} .mcv2__card {
      flex: 1 1 100%;
    }
  }

  @media (max-width: 600px) {
    #{{ section.id }} .mcv2__card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    #{{ section.id }} .mcv2__heading {
      font-size: 33px;
    }

    #{{ section.id }} .mcv2__image-wrap {
      width: 100%;
    }

    #{{ section.id }} .mcv2__content {
      align-items: center;
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Multi-column v2",
  "class": "cc-multi-column-v2",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Looking For More Unique Gift Ideas?"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "link", "label": "Link" },
        { "value": "btn btn--primary", "label": "Primary button" },
        { "value": "btn btn--secondary", "label": "Secondary button" }
      ],
      "default": "btn btn--primary"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collection Name"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi-column v2",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  }
}
{% endschema %}
