{% endschema %}
<script>
  (function() {
    const shuffleTestimonials = () => {
      const slideshow = document.querySelector('#slideshow-{{ section.id }}');
      const dotsContainer = document.querySelector('.slideshow-pagination');

      if (slideshow && slideshow.children.length > 0) {
        const slides = Array.from(slideshow.children);
        
        // 1. Shuffle the entire list of reviews
        slides.sort(() => Math.random() - 0.5);

        // 2. CHOOSE HOW MANY TO SHOW (e.g., 5 reviews)
        // This makes the slider manageable and keeps the dots clean
        const numberToShow = 5;
        const selectedSlides = slides.slice(0, numberToShow);

        // 3. Clear the slideshow and put only the selected ones back
        slideshow.innerHTML = '';
        selectedSlides.forEach((slide, index) => {
          slide.classList.remove('is-active');
          slide.setAttribute('tabindex', '-1');
          slide.style.display = 'block'; // Ensure they aren't hidden
          
          if (index === 0) {
            slide.classList.add('is-active');
            slide.removeAttribute('tabindex');
          }
          
          slideshow.appendChild(slide);
        });

        // 4. Update the Pagination Dots
        // We remove the old dots and let the theme's JS rebuild them for just 5 slides
        if (dotsContainer) {
          const dotTemplate = dotsContainer.querySelector('.page-btn');
          if (dotTemplate) {
            dotsContainer.innerHTML = ''; // Clear the 50 dots
            selectedSlides.forEach((_, index) => {
              const newDot = dotTemplate.cloneNode(true);
              newDot.setAttribute('data-index', index);
              newDot.setAttribute('aria-current', index === 0 ? 'true' : 'false');
              dotsContainer.appendChild(newDot);
            });
            dotsContainer.style.display = 'flex'; // Ensure dots are visible
          }
        }
      }
    };

    // Run the shuffle
    shuffleTestimonials();
  })();
</script>