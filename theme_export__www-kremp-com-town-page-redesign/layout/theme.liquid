      $(document).ready(function () {
        function positionCalendar(input) {
          const $calendar = $('.flatpickr-calendar.open:visible');
          const $input = $(input);

          if ($calendar.length && $input.length && !$calendar.attr('style')) {
            const offset = $input.offset();
            const inputHeight = $input.outerHeight();

            $calendar.css({
              position: 'absolute',
              top: offset.top + inputHeight + 3,
              left: offset.left,
              right: 'auto',
            });
          }
        }

        function queueCalendarPosition(input) {
          if (!input) return;
          requestAnimationFrame(function () {
            positionCalendar(input);
            setTimeout(function () {
              positionCalendar(input);
            }, 100);
          });
        }

        queueCalendarPosition(document.getElementById('flatpickrButton'));

        $('#flatpickrButton').on('click', function () {
          queueCalendarPosition(this);
        });
