      $('button.btn.btn--primary.btn--icon-with-text.w-full').addClass('exinent');
      return /^\d{5}(-\d{4})?$/.test(zip);
      
    }
  }

  // Validate ZIP against all cart items
  function validateZipForCart(zip) {
    if (typeof window.cartShipTypes === 'undefined') {
      return false; // No data, fail safe
    }

    for (let key in window.cartShipTypes) {
      if (window.cartShipTypes.hasOwnProperty(key)) {
        let shipTypes = window.cartShipTypes[key];
        if (!isValidUSZip(zip, shipTypes)) {
          return false; // if any item fails, stop
        }
      }
