    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const replacements = {
          'â€œ': '“',
          'â€': '”',
          'â€™': '’',
          'â€“': '–',
          'â€”': '—'
        };

        function replaceText(text) {
          let nextText = text;
          for (const [badChar, goodChar] of Object.entries(replacements)) {
            nextText = nextText.replaceAll(badChar, goodChar);
          }
          return nextText;
        }

        function fixTextNodes(root) {
          if (!root) return;

          if (root.nodeType === Node.TEXT_NODE) {
            root.nodeValue = replaceText(root.nodeValue);
            return;
          }

          const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          let node;
          while ((node = walker.nextNode())) {
            node.nodeValue = replaceText(node.nodeValue);
          }
        }

        fixTextNodes(document.body);

        const observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(fixTextNodes);
          });
        });

        observer.observe(document.body, { childList: true, subtree: true });
        setTimeout(function () {
          observer.disconnect();
        }, 10000);
      });
    </script>




