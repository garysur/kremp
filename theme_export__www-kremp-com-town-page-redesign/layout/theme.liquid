      <script>
        $(document).ready(function () {
          const continuebtn = $('#continuebtn');
          continuebtn.on('click', function () {
            $('#flatpickrButton').prop('disabled', false);
            flatpickrVals = $('#flatpickrButton').val().trim();
            if (flatpickrVals == '') {
              setTimeout(function () {
                const allDays = document.querySelectorAll('.flatpickr-day');
                const firstEnabledDay = document.querySelector('.flatpickr-day:not(.flatpickr-disabled)');

                if (firstEnabledDay) {
                  // Remove 'selected' from all days
                  allDays.forEach((day) => day.classList.remove('selected'));

                  // Add 'selected' class to the first enabled day
                  firstEnabledDay.classList.add('selected');

                  // Simulate click to trigger Flatpickr's internal logic
                  firstEnabledDay.click();
                }
              }, 500);
            }
          });
        });
      </script>
