<script>
    function blockUpcartCheckout() {
  const upcart = document.querySelector('#upCart');
  if (!upcart || !upcart.shadowRoot) return false;

  const checkoutBtn = upcart.shadowRoot.querySelector(
    'a.upcart-checkout-button'
  );

  if (!checkoutBtn || checkoutBtn.dataset.surmarketingDeliveryGuard === 'true') return true;
  checkoutBtn.dataset.surmarketingDeliveryGuard = 'true';

  checkoutBtn.addEventListener('click', function (e) {
    e.preventDefault();
    e.stopImmediatePropagation();
    console.log('Upcart checkout blocked');
    const localDeliveryDate = localStorage.getItem('deliveryDate');

  // If there's no date at all in localStorage
  if (!localDeliveryDate) {
    console.log('No delivery date in localStorage → redirecting to cart');
    window.location.href = '/cart';
    return;
  }

  // Convert localStorage date string into Date object for comparison
  const parsedLocalDate = new Date(localDeliveryDate);
  const today = new Date();
  today.setHours(0, 0, 0, 0); // normalize to start of the day

  // Fetch the cart JSON to check cart's deliveryDate property
  fetch('/cart.js')
    .then(res => res.json())
    .then(cart => {
      const cartDeliveryDate = cart.attributes?.deliveryDate || '';
	  console.log("localDeliveryDate",localDeliveryDate); 	
	  console.log("cartDeliveryDate",cartDeliveryDate);
	   console.log("parsedLocalDate",parsedLocalDate);
	    console.log("today",today);
      // Compare dates and attributes
      if (
        cartDeliveryDate !== localDeliveryDate || // mismatch
        parsedLocalDate <= today // date is today or earlier
      ) {
        console.log('Delivery date mismatch or expired → redirecting to cart');
        window.location.href = '/cart';
      } else {
        console.log('Delivery date valid → proceeding to checkout');
        window.location.href = '/checkout';
      }
    })
    .catch(err => {
      console.error('Error fetching cart:', err);
      window.location.href = '/cart';
    });
  });
}

function connectUpcartDeliveryGuard() {
  blockUpcartCheckout();

  const upcart = document.querySelector('#upCart');
  if (!upcart || !upcart.shadowRoot || window.__upcartDeliveryGuardObserver) return false;

  window.__upcartDeliveryGuardObserver = new MutationObserver(blockUpcartCheckout);
  window.__upcartDeliveryGuardObserver.observe(upcart.shadowRoot, { childList: true, subtree: true });
  return true;
}

document.addEventListener('DOMContentLoaded', function () {
  if (connectUpcartDeliveryGuard()) return;

  const hostObserver = new MutationObserver(function () {
    if (connectUpcartDeliveryGuard()) {
      hostObserver.disconnect();
    }
  });

  hostObserver.observe(document.body, { childList: true, subtree: true });
  setTimeout(function () {
    hostObserver.disconnect();
  }, 30000);
});
  </script>


{%- if is_delivery_template -%}
 <script>
  document.addEventListener('DOMContentLoaded', function () {

  const input = document.getElementById('flatpickrButton');
  const containerCal =  document.querySelector('.zip-n-cal__input-area');
  if (!input) return; // PDP only

  if (!input._flatpickr) {
    flatpickr(input, {
      appendTo: containerCal,   
      static: false,
      clickOpens: false,         
      disableMobile: true,
      dateFormat: "Y-m-d"
    });
  }

});


(function () {
 
  function getInput() {
    return document.getElementById('flatpickrButton');
  }
 
  function getFP() {
    const input = getInput();
    if (!input) return null;
    return input._flatpickr || null;
  }
 
  function isValidZip() {
    const zip = document.getElementById('zipCodeInput');
    return zip && zip.value.trim().length >= 4;
  }
 
  let fpOpening = false;
 
  function openCalendar(reason) {
    const input = getInput();
    const fp = getFP();
 
    if (!input || !fp || fpOpening) return;
 
    fpOpening = true;
    console.log('[Flatpickr]', reason);
 
    fp._positionElement = input;
 
    if (fp.calendarContainer) {
      fp.calendarContainer.style.top = '';
      fp.calendarContainer.style.left = '';
      fp.calendarContainer.style.right = '';
      fp.calendarContainer.style.bottom = '';
    }
 
    fp.close();
    input.disabled = false;
 
    setTimeout(() => {
  fp.open();
 
  if (fp._positionCalendar) {
    fp._positionCalendar();
  }
 
  fpOpening = false;
}, 0);
  }
 
let zipInput = document.getElementById('zipCodeInput');
 
if (zipInput) {
  zipInput.addEventListener('input', function () {
    const fp = getFP();
    if (!fp) return;
 
    fp.close();
 
    // Only clear if no date is selected
    if (fp.selectedDates.length === 0) {
      fp.clear();
    }
 
    fpOpening = false;
  });
}
 
  const dateInput = document.getElementById('flatpickrButton');
 
  if (dateInput) {
    dateInput.addEventListener('input', function () {
      const fp = getFP();
      if (!fp) return;
 
      if (!dateInput.value) {
        fp.close();
        fpOpening = false;
      }
    });
  }

  function syncDeliveryAttributes() {
    var selectedDateEl = document.getElementById('selectedCalendarDate');
    var deliveryDate = localStorage.getItem('deliveryDate')
      || (selectedDateEl ? selectedDateEl.textContent.trim() : '')
      || (dateInput ? dateInput.value : '');
    var zipCode = localStorage.getItem('zipCode')
      || (zipInput ? zipInput.value.trim() : '');

    document.querySelectorAll('input[name="attributes[deliveryDate]"]').forEach(function (input) {
      if (deliveryDate) input.value = deliveryDate;
    });

    document.querySelectorAll('input[name="attributes[zipCode]"]').forEach(function (input) {
      if (zipCode) input.value = zipCode;
    });
  }

  document.addEventListener('click', function (e) {
    if (
      e.target.closest('button[name="add"]') ||
      e.target.closest('order-conflict-checker')
    ) {
      syncDeliveryAttributes();
    } else if (e.target.closest('.flatpickr-day')) {
      setTimeout(syncDeliveryAttributes, 0);
    }
  }, true);

  document.addEventListener('change', function (e) {
    if (e.target.closest('#flatpickrButton') || e.target.closest('#zipCodeInput')) {
      setTimeout(syncDeliveryAttributes, 0);
    }
  }, true);
 
  document.addEventListener('click', function (e) {
 
    if (
      e.target.closest('button[name="add"]') ||
      e.target.closest('form[action*="/cart/add"]')
    ) {
      return;
    }
 
  if (e.target.closest('#continuebtn')) {
  if (!isValidZip()) return;
 
  const fp = getFP();
  if (fp && fp.selectedDates.length > 0) {
    return; // date already selected → don't open calendar
  }
 
  openCalendar('Continue clicked');
  return;
}
 
    if (e.target.closest('#flatpickrButton') || e.target.closest('.edit')) {
      if (!isValidZip()) return;
      openCalendar('Edit clicked');
    }
 
  }, true);
 
})();
if(window.location.pathname.includes("cart")){
  function syncCartDeliveryDate() {
    const selectedDay = document.querySelector('.flatpickr-day.selected');
    const selectedDate = selectedDay ? selectedDay.getAttribute('aria-label') : null;

    if (selectedDate && localStorage.getItem('deliveryDate') !== selectedDate) {
      localStorage.setItem('deliveryDate', selectedDate);
    }
  }

  document.addEventListener('click', function (event) {
    if (event.target.closest('.flatpickr-day')) {
      setTimeout(syncCartDeliveryDate, 0);
    }
  }, true);

  document.addEventListener('change', syncCartDeliveryDate, true);
  syncCartDeliveryDate();
}
</script>
{%- endif -%}


