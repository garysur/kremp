  .then(cart => {
    const today = new Date();

    // Helper to get 3 days from today (+1 if Sunday)
    function getNewDate() {
      const newDate = new Date(today);
      newDate.setDate(today.getDate() + 3);
      if (newDate.getDay() === 0) {  // Sunday check
        newDate.setDate(newDate.getDate() + 1); // Add 1 more day
      }
      return newDate;
    }

    // Format as "MMM DD, YYYY"
    function formatDate(date) {
      return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric"
      });
    }

    let deliveryDateStr = cart.attributes?.deliveryDate || "";
    let shouldUpdate = false;

    if (!deliveryDateStr) {
      shouldUpdate = true;
    } else {
      const existingDate = new Date(deliveryDateStr);
      if (existingDate < today) {
        shouldUpdate = true;
      }
    }

    if (shouldUpdate) {
      const newDateFormatted = formatDate(getNewDate());

      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          attributes: {
            ...cart.attributes,
            deliveryDate: newDateFormatted
          }
        })
      })
      .then(res => res.json())
      .then(updatedCart => {
        console.log("Updated delivery date:", updatedCart.attributes.deliveryDate);
      });
    } else {
      console.log("Delivery date is fine:", deliveryDateStr);
    }
  });

