    },
    {
      "type": "header",
      "content": "Trust point 2 — Family"
    },
    {
      "type": "text",
      "id": "point2_title",
      "label": "Title",
      "default": "Family-owned since 1956"
    },
    {
      "type": "textarea",
      "id": "point2_text",
      "label": "Description",
      "default": "Still designed and delivered by the Kremp family — 3 generations of floral expertise."
    },
    {
      "type": "header",
      "content": "Trust point 3 — Local"
    },
    {
