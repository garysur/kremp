      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Number",
      "default": "3rd"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Label",
      "default": "Generation family business"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Number",
      "default": "10K+"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Label",
      "default": "5-star Google reviews"
