{%- liquid
  assign all_properties_empty = true

  for line_item in order.line_items
    for property in line_item.properties
      unless property.last == blank
        assign all_properties_empty = false
        break
      endunless
    endfor
  endfor
-%}

<div class="account-nav">
  <div class="container flex justify-center">
    <a class="btn btn--secondary btn--arrow-back-with-text" href="{{ routes.account_url }}">
      {{- 'customer.account.home' | t -}}
    </a>
  </div>
</div>

<div class="section customer">
  <div class="container">
    <div class="account-width mx-auto text-center">
      <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
      {%- assign order_date = order.created_at | date: format: 'date_at_time' -%}
      <p dir="ltr">{{ 'customer.order.date' | t: date: order_date }}</p>

      {%- if order.cancelled -%}
        {%- assign cancelled_at = order.cancelled_at | date: format: 'date_at_time' -%}
        <p dir="ltr">{{ 'customer.order.cancelled_on' | t: date: cancelled_at }}</p>
        <p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} FTD Delivery Status Message {%- endcomment -%}
    {%- assign ftd_zone = order.metafields.ftd["delivery zone name"] | upcase | strip -%}
    {%- assign ftd_status = order.metafields.ftd["delivery status"] | downcase | strip -%}
    {%- assign ftd_date = order.metafields.ftd["delivery date"] | strip -%}
    {%- assign shopify_delivery_date = order.metafields.shipping.delivery_date | strip -%}
    {%- assign ftd_date_formatted = ftd_date | date: '%B %d, %Y' -%}
    {%- assign today = 'now' | date: '%Y-%m-%d' -%}
    {%- assign ftd_date_compare = ftd_date | date: '%Y-%m-%d' -%}

    {%- assign local_zones = "CC-CC,CC-NS,CC-WP,CC-SP,L-AJ,LB-BB,LB-FNE,LB-LL,LB-SH,LB-YN,L-EP,L-GW,L-HV,ML-D,ML-DC,ML-L,ML-NOR,NE-CR,NE-GT,NE-MD,NE-OL,U-AM,U-DOY,U-HH,U-HP,U-LNW,WG" | split: "," -%}
    {%- assign wire_zones = "WIRE,WIRE OUT" | split: "," -%}
    {%- assign shipped_zones = "DS-FEDEX,DS-UPS,DS-USPS" | split: "," -%}

    {%- if local_zones contains ftd_zone -%}
      {%- assign zone_type = "LOCAL" -%}
    {%- elsif wire_zones contains ftd_zone -%}
      {%- assign zone_type = "WIRE" -%}
    {%- elsif ftd_zone == "FIG" -%}
      {%- assign zone_type = "FIG" -%}
    {%- elsif shipped_zones contains ftd_zone -%}
      {%- assign zone_type = "SHIPPED" -%}
    {%- elsif ftd_zone == "WEB PICKUP" -%}
      {%- assign zone_type = "PICKUP" -%}
    {%- endif -%}

    {%- if ftd_date_compare < today -%}
      {%- assign pending_type = "past" -%}
    {%- else -%}
      {%- assign pending_type = "future" -%}
    {%- endif -%}

    {%- assign is_flex = false -%}
    {%- if shopify_delivery_date contains "Flex" -%}
      {%- assign is_flex = true -%}
    {%- endif -%}

    {%- assign ftd_message = "" -%}

    {%- if zone_type != blank and ftd_status != blank -%}

      {%- if is_flex -%}
        {%- if zone_type == "WIRE" -%}
          {%- if ftd_status == "delivered" -%}
            {%- assign ftd_message = "This order has been delivered. Thank you for choosing Kremp.com!" -%}
          {%- elsif ftd_status == "pending" -%}
            {%- if pending_type == "past" -%}
              {%- assign ftd_message = "All orders placed during the flex holiday delivery period are being delivered as quickly as possible. Please refer to your order confirmation email for more information." -%}
            {%- else -%}
              {%- assign ftd_message = "We have your order in the queue to be delivered within the flex holiday delivery period. Please refer to your order confirmation email for more information." -%}
            {%- endif -%}
          {%- elsif ftd_status == "cancelled" -%}
            {%- assign ftd_message = "This order shows as being cancelled. If this does not seem accurate, please reach out to us. We are happy to look into this further." -%}
          {%- endif -%}
        {%- endif -%}

      {%- else -%}

        {%- if ftd_status == "delivered" -%}
          {%- if zone_type == "LOCAL" -%}
            {%- assign ftd_message = "Your order has been delivered. The delivery took place on " | append: ftd_date_formatted | append: ". Thank you for choosing Kremp.com!" -%}
          {%- elsif zone_type == "WIRE" -%}
            {%- assign ftd_message = "This order has been delivered. Thank you for choosing Kremp.com!" -%}
          {%- elsif zone_type == "FIG" or zone_type == "SHIPPED" -%}
            {%- assign ftd_message = "This order was delivered. For additional information, please refer to the tracking details that were emailed to you at the time we shipped." -%}
          {%- elsif zone_type == "PICKUP" -%}
            {%- assign ftd_message = "This order has been picked up. Thank you for choosing Kremp.com!" -%}
          {%- endif -%}

        {%- elsif ftd_status == "pending" -%}
          {%- if pending_type == "future" -%}
            {%- if zone_type == "LOCAL" -%}
              {%- assign ftd_message = "This order is scheduled for delivery on " | append: ftd_date_formatted | append: ". We will be sending a delivery confirmation email once this is delivered." -%}
            {%- elsif zone_type == "WIRE" -%}
              {%- assign ftd_message = "We have your order scheduled for delivery " | append: ftd_date_formatted | append: ". We do send delivery confirmation emails once the driver marks it delivered." -%}
            {%- elsif zone_type == "FIG" -%}
              {%- assign ftd_message = "All fig orders are shipped out when ready. You will receive tracking details once we ship." -%}
            {%- elsif zone_type == "SHIPPED" -%}
              {%- assign ftd_message = "We have your order scheduled to be shipped out on " | append: ftd_date_formatted | append: ". You will receive tracking details once we ship." -%}
            {%- elsif zone_type == "PICKUP" -%}
              {%- assign ftd_message = "This order is ready for pickup on " | append: ftd_date_formatted | append: ". Please bring your order confirmation when you arrive." -%}
            {%- endif -%}
          {%- else -%}
            {%- if zone_type == "LOCAL" -%}
              {%- assign ftd_message = "This order should have been delivered on " | append: ftd_date_formatted | append: ". Most likely the driver tagged the door and we are waiting to hear from the recipient to schedule the redelivery. Feel free to reach out to us if you have additional contact information for the recipient." -%}
            {%- elsif zone_type == "WIRE" -%}
              {%- assign ftd_message = "This order should have been delivered on " | append: ftd_date_formatted | append: " but we did not get confirmation from our delivery service just yet. Please reach out to us so we can look into this further and get your confirmation." -%}
            {%- elsif zone_type == "FIG" -%}
              {%- assign ftd_message = "All fig orders are shipped out when ready. You will receive tracking details once we ship." -%}
            {%- elsif zone_type == "SHIPPED" -%}
              {%- assign ftd_message = "Since this order is shipped, please refer to the tracking information provided by the shipping carrier (Fedex/UPS/USPS)." -%}
            {%- endif -%}
          {%- endif -%}

        {%- elsif ftd_status == "cancelled" -%}
          {%- assign ftd_message = "This order shows as being cancelled. If this does not seem accurate, please reach out to us. We are happy to look into this further." -%}
        {%- endif -%}

      {%- endif -%}

      {%- if ftd_message != blank -%}
        <div class="account-width mt-12 mx-auto text-center">
          <div style="background:#f9f5ef;border:1px solid #e0d6c8;border-radius:8px;padding:24px 32px;">
            <h2 class="h5" style="margin-bottom:12px;">Delivery Status</h2>
            <p style="margin-bottom:0;">{{ ftd_message }}</p>
          </div>
          <p style="margin-top:16px;font-size:0.9em;color:#555;">
            Have questions? <a href="https://www.kremp.com/pages/contact">Send us a message</a> — we're happy to help.
          </p>
        </div>
      {%- endif -%}

    {%- endif -%}

    <div class="account-width mt-12 mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-theme">
        <div class="address-box w-full h-full mx-auto">
          <h2 class="h5">{{ 'customer.order.billing_address' | t }}</h2>
          <p>
            <strong>{{ 'customer.order.payment_status' | t }}:</strong>
            {{ order.financial_status_label }}
          </p>
          <address>
            {{ order.billing_address | format_address }}
          </address>
        </div>
        <div class="address-box w-full h-full mx-auto">
          <h2 class="h5">{{ 'customer.order.shipping_address' | t }}</h2>
          <p>
            <strong>{{ 'customer.order.fulfillment_status' | t }}:</strong>
            {{ order.fulfillment_status_label }}
          </p>
          <address>
            {{ order.shipping_address | format_address }}
          </address>
        </div>
      </div>
    </div>

    <div class="account-width mt-12 mx-auto">
      <h2 class="h3 text-center">{{ 'customer.order.order_details' | t }}</h2>
      <table class="order-detail w-full mt-6">
        <caption class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
        <thead>
        <tr>
          <th colspan="3">{{ 'customer.order.product' | t }}</th>
          <th class="text-center">{{ 'customer.order.quantity' | t }}</th>
          <th class="text-end">{{ 'customer.order.total' | t }}</th>
        </tr>
        </thead>
        <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td class="order-detail__image">
            {%- if line_item.url != blank -%}
              <a href="{{ line_item.url }}">
                {%- endif -%}
                {%- if line_item.image -%}
                  {%- capture sizes -%}
                    {%- render 'sizes-attribute', min: '64px', sm: false, md: '128px', lg: false, xl: false, max: false -%}
                  {%- endcapture -%}
                  {{ line_item.image | image_url: width: 256 | image_tag: widths: '64, 128, 256', sizes: sizes, loading: 'lazy' }}
                {%- else -%}
                  <div class="media relative" style="padding-top: 100%;">
                    {{ 'image' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                  </div>
                {%- endif -%}
                {%- if line_item.url != blank -%}
              </a>
              {%- endif -%}
            </td>
            <td class="order-detail__product" colspan="2">
              <p class="mb-0">
                {%- if line_item.url != blank -%}
                  <a class="font-bold text-current" href="{{ line_item.url }}">{{ line_item.title }}</a>
                {%- else -%}
                  {{ line_item.title }}
                {%- endif -%}
              </p>

              {%- if line_item.sku != blank -%}
                <p class="text-sm">{{ 'customer.order.sku' | t }}: {{ line_item.sku }}</p>
              {%- endif -%}

              {%- if line_item.original_price != line_item.final_price or line_item.unit_price_measurement -%}
                <dl>
                  {%- if line_item.original_price != line_item.final_price -%}
                    <dt>
                      <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                    </dt>
                    <dd class="inline m-0 font-bold">
                      {{ line_item.final_price | money }}
                    </dd>
                    <dt>
                      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                    </dt>
                    <dd class="inline m-0">
                      <s>{{ line_item.original_price | money }}</s>
                    </dd>
                  {%- else -%}
                    <dt>
                      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                    </dt>
                    <dd class="inline m-0 font-bold">
                      {{ line_item.original_price | money }}
                    </dd>
                  {%- endif -%}

                  {%- if line_item.unit_price_measurement -%}
                    <dt>
                      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                    </dt>
                    <dd class="unit-price">
                      <span class="unit-price__price">{{ line_item.unit_price | money }}</span>
                      <span class="unit-price__separator">{{ 'products.product.price.unit_price_separator' | t }}</span>
                      <span class="unit-price__unit">
                          {%- if line_item.unit_price_measurement.reference_value != 1 -%}
                            {{- line_item.unit_price_measurement.reference_value -}}
                          {%- endif -%}
                        {{ line_item.unit_price_measurement.reference_unit }}
                        </span>
                    </dd>
                  {%- endif -%}
                </dl>
              {%- else -%}
                <span>{{ line_item.final_price | money }}</span>
              {%- endif -%}

              {%- assign property_size = line_item.properties | size -%}

              {%- unless line_item.selling_plan_allocation == nil and property_size == 0 -%}
                <div class="order__properties">
                  {%- unless line_item.product.has_only_default_variant or line_item.product.gift_card? -%}
                    <div>{{ line_item.variant.title }}</div>
                  {%- endunless -%}

                  {%- unless line_item.selling_plan_allocation == nil -%}
                    <div>{{ line_item.selling_plan_allocation.selling_plan.name }}</div>
                  {%- endunless -%}

                  {%- if property_size != 0 and all_properties_empty == false -%}
                    <div class="mt-4 mb-4">
                      {%- for property in line_item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.first contains 'Recipient' and property.last != '' -%}
                          <div class="line-item-property">
                            <strong>{{ property.first | remove: 'properties[' | remove: ']' }}:</strong> {{ property.last }}
                          </div>
                        {%- elsif property.last != blank and property_first_char != '_' -%}
                          <div>
                            <strong>{{ property.first }}:</strong>
                            {%- if property.last contains '/uploads/' -%}
                              <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                            {%- else -%}
                              {{ property.last }}
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endunless -%}

              {%- if line_item.line_level_discount_allocations != blank -%}
                <ul class="order__discounts mt-3" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                  {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                    <li class="mt-2">
                      <div class="discount inline-flex items-start font-bold" dir="auto">
                        {% render 'icon-tags' %}
                        <span>{{ discount_allocation.discount_application.title | escape_once }} (-{{ discount_allocation.amount | money }})</span>
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if line_item.fulfillment -%}
                <div class="order__fulfillment">
                  {%- assign created_at = line_item.fulfillment.created_at | time_tag: format: 'date' | strip_html -%}
                  <span dir="ltr">{{ 'customer.order.fulfilled_on' | t: date: created_at }}</span>

                  {%- if line_item.fulfillment.tracking_url -%}
                    <a href="{{ line_item.fulfillment.tracking_url }}">
                      {{ 'customer.order.track_shipment' | t }}
                    </a>
                  {%- endif -%}

                  <span>
                      {{ line_item.fulfillment.tracking_company }}
                    {%- if line_item.fulfillment.tracking_number %}#{{ line_item.fulfillment.tracking_number }}{% endif -%}
                    </span>
                </div>
              {%- endif -%}
            </td>
            <td class="order-detail__qty text-center" data-label="{{ 'customer.order.quantity' | t }}:">
              {{ line_item.quantity }}
            </td>
            <td class="order-detail__price price text-end" data-label="{{ 'customer.order.total' | t }}:">
              {%- if line_item.original_line_price != line_item.final_line_price -%}
                <dl>
                  <dt>
                    <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                  </dt>
                  <dd class="m-0 font-bold">
                    {{ line_item.final_line_price | money }}
                  </dd>
                  <dt>
                    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                  </dt>
                  <dd class="m-0">
                    <s>{{ line_item.original_line_price | money }}</s>
                  </dd>
                </dl>
              {%- else -%}
                <strong>{{- line_item.original_line_price | money -}}</strong>
              {%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
        </tbody>
        <tfoot>
        <tr>
          <td colspan="2"></td>
          <td colspan="2">{{ 'customer.order.subtotal' | t }}:</td>
          <td class="text-end" data-label="{{ 'customer.order.subtotal' | t }}">
            {{ order.line_items_subtotal_price | money }}
          </td>
        </tr>

        {%- if order.cart_level_discount_applications != blank -%}
          {%- for discount_application in order.cart_level_discount_applications -%}
            <tr>
              <td colspan="2"></td>
              <td colspan="2">{{ 'customer.order.discount' | t }} ({{ discount_application.title }}):</td>
              <td class="text-end" data-label="{{ 'customer.order.discount' | t }}">
                <span>-{{ discount_application.total_allocated_amount | money }}</span>
              </td>
            </tr>
          {%- endfor -%}
        {%- endif -%}

        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="2"></td>
            <td colspan="2">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }}):</td>
            <td class="text-end" data-label="{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})">
              {{ shipping_method.price | money }}
            </td>
          </tr>
        {%- endfor -%}

        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="2"></td>
            <td colspan="2">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%):</td>
            <td class="text-end" data-label="{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)">
              {{ tax_line.price | money }}
            </td>
          </tr>
        {%- endfor -%}

        {%- if order.total_duties -%}
          <tr>
            <td colspan="2"></td>
            <td colspan="2">{{ 'customer.order.total_duties' | t }}:</td>
            <td class="text-end" data-label="{{ 'customer.order.total_duties' | t }}">
              {{ order.total_duties | money }}
            </td>
          </tr>
        {%- endif -%}

        <tr class="order-detail__total-row">
          <td colspan="2"></td>
          <td colspan="2"><strong class="uppercase">{{ 'customer.order.total' | t }}:</strong></td>
          <td class="text-end" data-label="{{ 'customer.order.total' | t }}">
            <strong>{{ order.total_price | money_with_currency }}</strong>
          </td>
        </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>