      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Heading italic accent",
      "default": "#d9f09c"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#c8d8e8"
    },
    {
      "type": "color",
      "id": "check_color",
