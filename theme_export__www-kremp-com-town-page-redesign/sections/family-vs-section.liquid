  "max": 100,
  "step": 4,
  "default": 0
},
    {
      "type": "header",
      "content": "Panel colors"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "default": "#1b3a6b"
    },
    {
