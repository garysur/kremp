{{ 'new-town-pages.css' | asset_url | stylesheet_tag }}

<div class="kremp-trust-bar" style="background-color: {{ section.settings.bg_color }}; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(0,0,0,0.08);">
  <div style="max-width: 1620px; margin: 0 auto; padding: 12px 24px; display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 30px;">

    <div style="display:flex; align-items:center; gap:10px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      <div>
        <div style="color:{{ section.settings.title_color }}; font-weight:600; font-size:14px; line-height:1.3; margin:0;">{{ section.settings.item1_title }}</div>
        <div style="color:{{ section.settings.sub_color }}; font-size:12px; line-height:1.3; margin:0;">{{ section.settings.item1_sub }}</div>
      </div>
    </div>

    <div style="width:1px; height:32px; background:rgba(255,255,255,0.2); flex-shrink:0;"></div>

    <div style="display:flex; align-items:center; gap:10px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <div>
        <div style="color:{{ section.settings.title_color }}; font-weight:600; font-size:14px; line-height:1.3; margin:0;">{{ section.settings.item2_title }}</div>
        <div style="color:{{ section.settings.sub_color }}; font-size:12px; line-height:1.3; margin:0;">{{ section.settings.item2_sub }}</div>
      </div>
    </div>

    <div style="width:1px; height:32px; background:rgba(255,255,255,0.2); flex-shrink:0;"></div>

    <div style="display:flex; align-items:center; gap:10px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <div>
        <div style="color:{{ section.settings.title_color }}; font-weight:600; font-size:14px; line-height:1.3; margin:0;">{{ section.settings.item3_title }}</div>
        <div style="color:{{ section.settings.sub_color }}; font-size:12px; line-height:1.3; margin:0;">{{ section.settings.item3_sub }}</div>
      </div>
    </div>

    <div style="width:1px; height:32px; background:rgba(255,255,255,0.2); flex-shrink:0;"></div>

    <div style="display:flex; align-items:center; gap:10px;">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12 19.79 19.79 0 0 1 1.95 3.37 2 2 0 0 1 3.91 1.17h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <div>
        <div style="color:{{ section.settings.title_color }}; font-weight:600; font-size:14px; line-height:1.3; margin:0;">{{ section.settings.item4_title }}</div>
        <div style="color:{{ section.settings.sub_color }}; font-size:12px; line-height:1.3; margin:0;">{{ section.settings.item4_sub }}</div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1b3a6b"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "sub_color",
      "label": "Subtitle text color",
      "default": "#a8c0d8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#d9f09c"
    },
    {
      "type": "header",
      "content": "Item 1 — Rating"
    },
    {
      "type": "text",
      "id": "item1_title",
      "label": "Title",
      "default": "4.8★ on Google"
    },
    {
      "type": "text",
      "id": "item1_sub",
      "label": "Subtitle",
      "default": "Over 10k verified reviews"
    },
    {
      "type": "header",
      "content": "Item 2 — Delivery"
    },
    {
      "type": "text",
      "id": "item2_title",
      "label": "Title",
      "default": "Same-Day Delivery"
    },
    {
      "type": "text",
      "id": "item2_sub",
      "label": "Subtitle",
      "default": "Order by 2pm — delivered today"
    },
    {
      "type": "header",
      "content": "Item 3 — Local"
    },
    {
      "type": "text",
      "id": "item3_title",
      "label": "Title",
      "default": "Real Local Flower Shop"
    },
    {
      "type": "text",
      "id": "item3_sub",
      "label": "Subtitle",
      "default": "Local florists, not a wire service"
    },
    {
      "type": "header",
      "content": "Item 4 — Phone"
    },
    {
      "type": "text",
      "id": "item4_title",
      "label": "Title",
      "default": "Call Direct · 1 (800) 345-7367"
    },
    {
      "type": "text",
      "id": "item4_sub",
      "label": "Subtitle",
      "default": "Speak to our family team"
    }
  ],
  "presets": [
    {
      "name": "Trust Bar"
    }
  ]
}
{% endschema %}