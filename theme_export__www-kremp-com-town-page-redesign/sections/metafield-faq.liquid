{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign faq_meta = page.metafields.custom.custom_faq
-%}

{%- if faq_meta != blank -%}

  {%- unless section.settings.full_width -%}
    <div class="container">
  {%- endunless -%}

  <div class="section section--padded color-scheme color-scheme--{{ color_scheme }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}" id="{{ section.id }}">
    <div class="container">
      <div class="reading-width cc-animate-init cc-animate-in" data-cc-animate="">

        {%- if section.settings.heading != blank -%}
          <h2 class="h4 section__heading mb-12 text-center">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- assign nodes = faq_meta.value.children -%}
        {%- assign open_item = false -%}

        {%- for node in nodes -%}
          {%- if node.type == 'heading' -%}
            {%- if open_item -%}
                    </div></div></details></details-disclosure>
            {%- endif -%}
            {%- assign open_item = true -%}

            <details-disclosure>
              <details class="disclosure disclosure--row">
                <summary>
                  <div class="flex justify-between items-center">
                    <h3 class="disclosure__title disclosure__title--small xs:regular-text h6 font-body flex flex-auto items-center mb-0 text-current">
                      {{ node.children[0].value }}
                    </h3>
                    <span class="disclosure__toggle">
                      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false" role="presentation" class="icon"><path d="M20 8.5 12.5 16 5 8.5" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg>
                    </span>
                  </div>
                </summary>
                <div class="disclosure__panel has-motion">
                  <div class="disclosure__content rte">
          {%- elsif node.type == 'paragraph' and open_item -%}
            <p>{{ node.children[0].value }}</p>
          {%- endif -%}
        {%- endfor -%}

        {%- if open_item -%}
                  </div></div></details></details-disclosure>
        {%- endif -%}

      </div>
    </div>
  </div>

  {%- unless section.settings.full_width -%}
    </div>
  {%- endunless -%}

{%- endif -%}

{% schema %}
{
  "name": "Metafield FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{ "value": "1", "label": "1" }, { "value": "none", "label": "None" }], "default": "none" },
    { "type": "checkbox", "id": "full_width", "label": "Full Width", "default": true },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class" }
  ],
  "presets": [{ "name": "Metafield FAQ" }]
}
{% endschema %}
