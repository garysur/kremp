    "local_resources_block": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% assign resource_content = page.metafields.custom.local_ressources.value | strip %}{% if resource_content != blank %}<style>.kremp-resource-outer { padding: 100px 0; background-color: #fcfcfc; border-top: 1px solid #eee; }.kremp-resource-outer h2.main-title { font-size: 3.2rem !important; text-align: center; margin-bottom: 60px; color: #111; font-weight: 800; text-transform: capitalize; }.kremp-grid-layout { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; max-width: 1400px; margin: 0 auto; padding: 0 20px; align-items: start; }.kremp-grid-layout h3 { font-size: 1.8rem !important; color: #004b91; margin-bottom: 25px; margin-top: 0; font-weight: 700; border-bottom: 3px solid #004b91; padding-bottom: 10px; display: inline-block; }.kremp-grid-layout ul { list-style: none; padding: 0; margin: 0; text-align: left; }.kremp-grid-layout li { background: #fff; padding: 25px; margin-bottom: 20px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid #f0f0f0; transition: transform 0.3s ease; }.kremp-grid-layout li:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1); }.kremp-grid-layout li strong { display: block; font-size: 1.25rem; color: #111; margin-bottom: 8px; }.kremp-grid-layout li p { font-size: 1.1rem; color: #555; line-height: 1.5; margin: 0; }.kremp-grid-layout a { color: #004b91; text-decoration: none; font-weight: 700; border-bottom: 2px solid transparent; transition: all 0.2s ease; }.kremp-grid-layout a:hover { border-bottom: 2px solid #004b91; }</style><div class='kremp-resource-outer'><div class='page-width'><h2 class='main-title'>Local Services & Resources in {{ page.title }}</h2><div class='kremp-grid-layout'>{{ page.metafields.custom.local_ressources | metafield_tag }}</div></div></div>{% endif %}",
        "section_height": "default",
        "full_width": true,
        "dividers": "none",
