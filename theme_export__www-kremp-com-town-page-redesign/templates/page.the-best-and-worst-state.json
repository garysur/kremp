    "rich_text_jNN7pC": {
      "type": "rich-text",
      "blocks": {
        "heading_tJX6EY": {
          "type": "heading",
          "settings": {
            "heading": "The Metrics",
            "heading_size": "h4",
            "heading_h1": false
          }
        },
        "text_dmfEi6": {
          "type": "text",
          "settings": {
            "text": "<p>The states could earn up to 100 points each for Metrics 1–8 based on how well they performed against all of the other states. States could earn up to 75 points for Metrics 9–11 combined. A total of 875 points could be earned across all of the metrics.</p>",
            "enlarge_text": false
          }
        }
