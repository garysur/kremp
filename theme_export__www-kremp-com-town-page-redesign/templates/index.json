ympathy-gourmet-gi_1.jpg","heading":"Occasions","heading_bg_color":"#ffffff","heading_text_color":"#004275","menu":"hp-categories-occasions","button_label":"See All","button_link":"shopify:\/\/collections\/occasions"}},"column_KBKY9T":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/leather-trunk-succulent-garden-2.jpg","heading":"Plants","heading_bg_color":"#ffffff","heading_text_color":"#004275","menu":"hp-categories-plants","button_label":"See All","button_link":"shopify:\/\/collections\/plants"}},"column_ExUa4t":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/a2bc__amuseable_birthday_cake_jellycat.jpg","heading":"Gift Shop","heading_bg_color":"#ffffff","heading_text_color":"#004275","menu":"hp-categories-gifts","button_label":"See All","button_link":"shopify:\/\/collections\/gift-shop"}}},"block_order":["links-column-0","column_JDht9d","column_KBKY9T","column_ExUa4t"],"settings":{"title":"Shop Popular Categories","heading_size":"h4","heading_align":"text-start","button_label":"All Collections","button_link":"shopify:\/\/collections","layout":"carousel","column_size":"small","column_align":"left","color_scheme":"none","image_ratio":"1","button_style":"btn--primary","custom_class":""}},"testimonials_J9rgDk":{"type":"testimonials","blocks":{"testimonial_ctEJA9":{"type":"testimonial","settings":{"testimonial":"<h3>“I’ve used Kremp for many years and they never disappoint. I’ve even spoken to the owner sometimes. Best service anyone could ask for. Thank you!”<\/h3>","author":"Marianna H.","author_info":"","show_star_rating":true,"star_rating":5}}},"block_order":["testimonial_ctEJA9"],"settings":{"heading":"","show_quotes":false,"testimonial_size":"h3","text_position":"justify-center","text_align":"text-center justify-center","new_design":false,"nav_style":"arrows","transition":"slide-fade","autoplay":false,"slider_pause":false,"autoplay_speed":5,"color_scheme":"1","full_width":true}},"media_with_text_kjxz4x":{"type":"media-with-text","blocks":{"heading_MLQBhp":{"type":"heading","settings":{"heading":"Who We Are","heading_size":"h3","heading_h1":false}},"text_UAPyii":{"type":"text","settings":{"text":"<p>Kremp Florist is a family-owned and operated flower shop that provides both local and nationwide delivery of flowers and gifts for every occasion.<br\/><br\/>Whether you're celebrating a national holiday or personal milestone or you just wish to order flowers for someone, Kremp Florist has the perfect gift or floral arrangement to fit the occasion.<br\/><br\/>We offer the best same day online flower delivery in Philadelphia as well as anywhere across the country. With our online floral delivery service, you can send flowers online and feel confident that they will be fresh and beautiful when they arrive in a timely manner.<\/p>","enlarge_text":false}},"button_CwpBE7":{"type":"button","settings":{"button_label":"Read More","button_link":"shopify:\/\/pages\/about-us","button_style":"btn btn--primary"}}},"block_order":["heading_MLQBhp","text_UAPyii","button_CwpBE7"],"settings":{"custom_class":"","is_award":false,"coordinates":"","image":"shopify:\/\/shop_images\/Kremp-bros.jpg","video_external":"","video_description":"","video_autoplay":false,"image_aspect_ratio":"natural","full_width":false,"vertical_padding":"default","layout":"right","image_fit":"contain","media_width":50,"media_scale":100,"text_align":"text-start","color_scheme":"none","only_content_color_scheme":false}},"video_pMQWcx":{"type":"video","settings":{"video_shopify":"shopify:\/\/files\/videos\/KREMP.mp4","video_external":"","video_description":"An explanation of why Kremp Florist can solve all of your flower delivery needs.","poster_image":"shopify:\/\/shop_images\/meet-top-video-cover.jpg","video_size":"lg","video_autoplay":false,"text_align":"text-center","color_scheme":"default"}},"featured_blog_M9E9Xa":{"type":"featured-blog","settings":{"title":"Our Blog","heading_align":"text-start","show_view_all":true,"blog":"the-kremp-florist-blog","layout":"carousel","posts_to_show":12,"show_featured_image":true,"show_tags":true,"show_excerpt":true,"show_author":false,"show_date":true,"show_button":false,"color_scheme":"none","image_ratio":"1","button_style":"btn btn--primary"}},"faq_8rhAdy":{"type":"faq","blocks":{"category_AKygmQ":{"type":"category","settings":{"text":"Here are some of our most-asked questions:"}},"question_H7hwFE":{"type":"question","settings":{"heading":"Can I send flowers to someone same day?","text":"<p>Yes, it is easy to buy flowers and send them to someone same day. No matter what the occasion may be, same day delivery is available nationwide by ordering online here. With a fast and easy checkout, your gift will be prepared right away and delivered to the recipient in a timely manner. Be sure to order before 12:30pm in the recipient’s time zone for fast, same day delivery. Note- during peak holidays like Valentine’s Day and Mother’s Day, same day delivery may only be available to local towns.<\/p>"}},"question_HUTkCc":{"type":"question","settings":{"heading":"What are the best flowers for same-day flower delivery?","text":"<p>The best flowers for same-day flower delivery would be whatever is the most fresh and in stock. When you order in advance, specific flower varieties can be ordered in for your future order. With same-day orders, we must use what is in stock at the time. Not to worry! Our flower shop coolers are always stocked with the freshest, most popular flower varieties such as roses, lilies, orchids, hydrangeas, gerbera daisies, sunflowers, and more! Our professional flower designers always select what looks the most beautiful for your gift while being suitable for the occasion.<\/p>"}},"question_RQD7by":{"type":"question","settings":{"heading":"What is the best flower delivery site?","text":"<p>The best flower delivery website is one that you can trust, not only to deliver on time but also to create a gift that both you and the recipient are happy with. Kremp Florist is a real retail florist, family owned and operated so you can trust the personalized level of service, the quality of the product to be fresh, and on-time flower delivery.<\/p>"}},"question_8THa9b":{"type":"question","settings":{"heading":"How much does flower delivery cost?","text":"<p>The cost of flower delivery can vary depending on the location of the recipient. Delivery charges can range from $5 up to $30. Labor, vehicle, and gas charges need to be covered somewhere in the transaction so be weary of websites that offer free delivery. Chances are, you will either be paying another mysterious service charge to cover this expense or the delivery fees may be deducted from the product price possibly leading to a smaller bouquet. If an offer sounds too good to be true, this is likely the case.<\/p>"}},"question_UzV8Et":{"type":"question","settings":{"heading":"How long does it take to have flowers delivered?","text":"<p>Most flower deliveries are made by early afternoon on the requested date of delivery. If the order is placed for same-day delivery before 12:30 pm in the recipient’s time zone, the order will go out in the afternoon. Flower delivery drivers can deliver into the evening if need be. Note- during peak holidays like Valentine’s Day and Mother’s Day, some areas may reach capacity in advance of the holiday. This means your order will be delivered as quickly as possible once delivery services start accepting more deliveries.<\/p>"}},"question_9AKXL6":{"type":"question","settings":{"heading":"Who delivers flowers near me?","text":"<p>Our local flower delivery experts are the best choice for flower delivery near you. As one of the top real retail florists in the country, in business for over 65 years, Kremp Florist is proud to offer the highest level of service for flower delivery anywhere in the United States. Whether it is a same-day birthday flower delivery, a get-well wish to cheer up someone in the hospital or a planned sympathy flower gift, Kremp Florist will fulfill your order in a timely manner with personalized service.<\/p>"}},"question_Y9BVgG":{"type":"question","settings":{"heading":"How can I get flowers delivered fast?","text":"<p>The easiest way to get flowers delivered fast is to order online from a flower shop you can trust. Within minutes, you can check out on our fast, easy and secure website. By ordering flowers and plants from a real retail florist, you can eliminate any concerns that may arise when ordering from large online websites that are not real florists. Shop Kremp Florist today and we will deliver fast.<\/p>"}}},"block_order":["category_AKygmQ","question_H7hwFE","question_HUTkCc","question_RQD7by","question_8THa9b","question_UzV8Et","question_9AKXL6","question_Y9BVgG"],"settings":{"heading":"Need some help?","color_scheme":"none","full_width":true,"custom_class":""}},"custom_liquid_mbCc66":{"type":"custom-liquid","name":"Custom HTML\/Liquid","settings":{"custom_liquid":"<div id=\"spotlight-container-main\"><\/div>\n\t<script src=\"https:\/\/sur-spotlight.com\/plugin\/v1\/resources\/js\/plugin.js?clientId=krempflorist&locationId=willowgrove\" defer><\/script>","section_height":"default","full_width":false,"dividers":"none","prevent_animation":false}},"image_banner_EDDaqW":{"type":"image-banner","blocks":{"heading_a3i9bi":{"type":"heading","settings":{"heading":"Still Not Sure Where To Start?","heading_size":"h2","heading_h1":false}},"text_7QnxVX":{"type":"text","settings":{"text":"<p>Let us help you to choose the perfect gift for your special occasion. Give us a call or send us an email. We are happy to help!<\/p>","enlarge_text":false}},"button_BaM93K":{"type":"button","settings":{"button_1_label":"(800) 345-7367","button_1_link":"tel:18003457367","button_1_style":"btn btn--primary","button_2_label":"Contact Us Online","button_2_link":"shopify:\/\/pages\/contact","button_2_style":"btn btn--secondary"}}},"block_order":["heading_a3i9bi","text_7QnxVX","button_BaM93K"],"settings":{"image_desktop":"shopify:\/\/shop_images\/Last_Bite_-_D.jpg","image_mobile":"shopify:\/\/shop_images\/last_bite_-_M.jpg","url":"","height_mode":"auto","fixed_height_desktop":600,"fixed_height_mobile":350,"overlay_position":"justify-start items-center","overlay_text_align":"text-start","mob_center_text":true,"mobile_stacked":true,"mobile_stacked_reverse":false,"mobile_stacked_text_bg":"#ffffff","mobile_stacked_text_bg_opacity":0,"color_scheme":"white","full_width":true,"transparent_content_color":"#004275","tint_color":"#000000","tint_opacity":0,"tint_tablet_only":false,"custom_class":"","prevent_animation":false}},"rich_text_qzh46h":{"type":"rich-text","blocks":{"heading_TjrCVz":{"type":"heading","settings":{"heading":"Family Owned and Operated for 3 Generations","heading_size":"h1","heading_h1":false}},"text_RcqLbH":{"type":"text","settings":{"text":"<p><a href=\"\/pages\/about-us\" title=\"About Us\">100% Satisfaction Guaranteed on every bouquet, every plant, every gift!<\/a><\/p>","enlarge_text":true}}},"block_order":["heading_TjrCVz","text_RcqLbH"],"name":"Rich text","settings":{"custom_class":"","text_position":"justify-center","text_align":"text-center","mob_center_text":true,"wide":false,"hide_if_empty":false,"color_scheme":"2","full_width":true,"prevent_animation":false}}},"order":["navigation_slideshow_j9AHeG","featured_collection_prtXrh","promo-grid","media-with-text","1763070857abe6b62a","link-lists","testimonials_J9rgDk","media_with_text_kjxz4x","video_pMQWcx","featured_blog_M9E9Xa","faq_8rhAdy","custom_liquid_mbCc66","image_banner_EDDaqW","rich_text_qzh46h"]}