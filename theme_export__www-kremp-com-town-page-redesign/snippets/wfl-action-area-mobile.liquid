        {%- if reserve_product -%}
          {% liquid
            assign reserved_metaobj = shop.metaobjects.product_cart_attribute.reserved
            assign reserved_name = reserved_metaobj.name.value
            assign reserved_value = reserved_metaobj.value.value
          %}
          <input
            type="hidden"
            name="properties[{{ reserved_name }}]"
            value="{{ reserved_value }}"
            hidden
          >
          {% if breakpoint_class == 'product-info__block--desktop' %}
            <reserve-button-checker></reserve-button-checker>
          {% endif %}
        {%- endif -%}
        <input
          type="hidden"
          name="properties[_shipping_type]"
          value="{{ product.metafields.custom.shipping_type.value }}"
        >
        <input
          type="hidden"
          name="properties[_box_size]"
          value="{{ product.metafields.custom.box_size.value }}"
        >
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div class="product-info__add-to-cart flex{% if enable_dynamic_checkout %} qty-input--secondary-btn{% endif %}">
          {%- if block.settings.show_qty_selector -%}
            {% render 'quantity-input', layout_style: 'combined' %}
          {%- else -%}
            <input type="hidden" name="quantity" value="1">
          {%- endif -%}

          <order-conflict-checker
            class="product-info__add-button"
            shipping-type="{{ product.metafields.custom.shipping_type.value }}"
          >
            {%- capture add_to_cart_text -%}
              {%- if product.template_suffix contains 'preorder' -%}
                {{- 'products.product.preorder' | t -}}
              {%- else -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- endif -%}
            {%- endcapture -%}

            <input
              type="hidden"
              name="attributes[deliveryDate]"
            >
            <input
              type="hidden"
              name="attributes[zipCode]"
            >
            <input
              type="hidden"
              name="attributes[shippingType]"
              value="{{ product.metafields.custom.shipping_type.value }}"
            >

            <button
              type="submit"
              data-add-to-cart-text="{{ add_to_cart_text | escape }}"
              class="btn btn--primary w-full"
              name="add"
              id ="addToCart"
              {% if product.available == false %}
                disabled
              {% endif %}
            >
               {%- if product.available -%}
                {{- add_to_cart_text -}}  &nbsp; - &nbsp;   
                <div class="product-info__price custom">
                 {% render 'price', product: product, use_variant: true  %}
               </div>
                
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}&nbsp; - &nbsp; 
                 <div class="product-info__price custom">
                 {% render 'price', product: product, use_variant: true  %}
               </div>
              {%- endif -%}
            </button>
          </order-conflict-checker>
        </div>

        {%- if enable_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}

        <div class="product-action-area__action-messages" data-action-messages></div>

        {%- if block.settings.show_product_messages -%}
          {% comment %}
            <div class="product-action-area__product-messages">
              {%- for product_message in product.metafields.custom.product_messages.value -%}
                <div class="product-message-pill">
                  {{ product_message.icon.value | image_url: width: 24 | image_tag: loading: 'lazy' }}
                  <span>{{ product_message.message.value }}</span>
                </div>
              {%- endfor -%}
            </div>
          {% endcomment %}
          <div class="product-action-area__product-messages">
            <div
              class="product-message-pill{% if product.selected_or_first_available_variant.available %} product-message-pill--active{% endif %}"
              data-product-message-pill="in-stock"
            >
              <img
                src="//956aaa-f0.myshopify.com/cdn/shop/files/Checkmark_Outline.svg?v=1724437687&amp;width=24"
                alt=""
                srcset="//956aaa-f0.myshopify.com/cdn/shop/files/Checkmark_Outline.svg?v=1724437687&amp;width=24 24w"
                width="24"
                height="25"
                loading="lazy"
              >
              <span>In Stock</span>
            </div>

            <div
              class="
                product-message-pill{% if product.selected_or_first_available_variant.compare_at_price
                and product.selected_or_first_available_variant.compare_at_price
                  > product.selected_or_first_available_variant.price %} product-message-pill--active{% endif %}
              "
              data-product-message-pill="on-sale"
            >
              <img
                src="//956aaa-f0.myshopify.com/cdn/shop/files/on_sale.svg?v=1724437744&amp;width=24"
                alt=""
                srcset="//956aaa-f0.myshopify.com/cdn/shop/files/on_sale.svg?v=1724437744&amp;width=24 24w"
                width="24"
                height="25"
                loading="lazy"
              >
              <span>On Sale</span>
            </div>

            <div
              class="product-message-pill product-message-pill--active"
              data-product-message-pill="guaranteed-delivery"
            >
              <img
                src="//956aaa-f0.myshopify.com/cdn/shop/files/location.svg?v=1724437744&amp;width=24"
                alt=""
                srcset="//956aaa-f0.myshopify.com/cdn/shop/files/location.svg?v=1724437744&amp;width=24 24w"
                width="24"
                height="25"
                loading="lazy"
              >
              <span>Guaranteed Delivery</span>
            </div>
          </div>
        {%- endif -%}

        {%- if block.settings.show_product_notes and product.metafields.custom.short_description.value -%}
          <div class="product-action-area__note">
            {{ product.metafields.custom.short_description.value }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
   
      </product-form>
   </div>

  {%- if block.settings.show_pickup_availability -%}
    {% render 'pickup-availability', current_variant: current_variant %}
  {%- endif -%}


